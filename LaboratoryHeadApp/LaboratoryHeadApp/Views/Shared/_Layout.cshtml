<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Портал кафедры ИС</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --galaxy: #0B1F5C;
            --planetary: #334EAC;
            --sky: #D0E3FF;
        }

        .app-navbar {
            background-color: var(--galaxy);
        }

            .app-navbar .navbar-brand,
            .app-navbar .nav-link {
                color: #ffffff;
            }

                .app-navbar .nav-link:hover,
                .app-navbar .nav-link:focus {
                    color: var(--sky);
                }

            .app-navbar .dropdown-menu {
                background-color: #ffffff;
            }

            .app-navbar .dropdown-item:hover {
                background-color: var(--planetary);
                color: #ffffff;
            }

        .btn-navbar-outline {
            color: #ffffff;
            border-color: #ffffff;
        }

            .btn-navbar-outline:hover {
                color: var(--galaxy);
                background-color: #ffffff;
                border-color: #ffffff;
            }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Портал кафедры ИС
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                    aria-expanded="false" aria-label="Переключатель навигации">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            Главная
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Mol" asp-action="Index">
                            МОЛ и оборудование
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Schedule" asp-action="Index">
                            Расписание занятий
                        </a>
                    </li>

@*                    <li class="nav-item">
                        <a class="nav-link" asp-controller="DutySchedule" asp-action="Index">
                            Расписание дежурств
                        </a>
                    </li>*@

                </ul>

                <div class="d-flex align-items-center gap-2">
                    <a class="btn btn-sm btn-navbar-outline" href="/polina/core">
                        Вернуться в главный модуль
                    </a>

                    <form method="post" action="/polina/auth/logout" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-light">
                            Выйти
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>