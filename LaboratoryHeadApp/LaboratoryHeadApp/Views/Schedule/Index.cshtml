@{
    ViewData["Title"] = "Модуль расписания";
    Layout = "_Layout";
}

<style>
    :root {
        --galaxy: #0B1F5C;
        --planetary: #334EAC;
        --sky: #D0E3FF;
        --line: rgba(11, 31, 92, .15);
        --soft: #f6f8ff;
    }

    .btn-galaxy {
        background-color: var(--galaxy);
        border-color: var(--galaxy);
        color: #fff;
    }

        .btn-galaxy:hover,
        .btn-galaxy:focus {
            background-color: var(--planetary);
            border-color: var(--planetary);
            color: #fff;
        }

    .btn-outline-galaxy {
        color: var(--galaxy);
        border-color: var(--galaxy);
    }

        .btn-outline-galaxy:hover,
        .btn-outline-galaxy:focus {
            background-color: var(--galaxy);
            color: #fff;
        }

    .dropdown-menu .dropdown-item:active {
        background-color: var(--planetary);
    }

    .sync-panel {
        border: 1px solid var(--line);
        border-radius: 18px;
        background: linear-gradient(180deg, #fff, var(--soft));
        padding: 18px;
        margin-bottom: 24px;
        box-shadow: 0 8px 22px rgba(11, 31, 92, .06);
    }

    .sync-title {
        font-weight: 700;
        color: var(--galaxy);
        margin-bottom: 4px;
    }

    .sync-text {
        color: #6c757d;
        font-size: .95rem;
    }

    .module-card {
        border: 1px solid var(--line);
        border-radius: 18px;
    }
</style>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="mb-0">Модуль расписания и графика дежурств</h2>

        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-galaxy">
            На главную
        </a>
    </div>

    <div class="sync-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="sync-title">Быстрое обновление данных</div>
                <div class="sync-text">
                    Обновите справочники групп и преподавателей из Core System или загрузите актуальное расписание занятий.
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <form asp-controller="Schedule"
                      asp-action="SyncCoreDictionaries"
                      method="post"
                      class="js-submit-once">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-galaxy"
                            data-loading-text="Синхронизация...">
                        Синхронизировать справочники
                    </button>
                </form>

                <form asp-controller="Schedule"
                      asp-action="SyncLessonsFromMain"
                      method="post"
                      class="js-submit-once">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-galaxy"
                            data-loading-text="Загрузка расписания...">
                        Синхронизировать расписание
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card module-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Время занятий</h5>
                    <p class="card-text">
                        Справочник времени учебных пар: номер пары, время начала и окончания.
                    </p>
                    <ul class="small mb-3">
                        <li>Номер пары</li>
                        <li>Время начала и окончания</li>
                        <li>Описание при необходимости</li>
                    </ul>
                    <div class="mt-auto">
                        <a asp-controller="LessonTime" asp-action="Index"
                           class="btn btn-galaxy">
                            Время пар
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card module-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Расписание занятий</h5>
                    <p class="card-text">
                        Просмотр расписания по аудиториям, преподавателям и учебным группам.
                    </p>
                    <ul class="small mb-3">
                        <li>Расписание по аудиториям</li>
                        <li>Расписание по преподавателям</li>
                        <li>Расписание по группам</li>
                    </ul>

                    <div class="mt-auto">
                        <div class="dropdown">
                            <button class="btn btn-outline-galaxy dropdown-toggle"
                                    type="button"
                                    id="lessonsDropdown"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                Выбрать раздел
                            </button>

                            <ul class="dropdown-menu" aria-labelledby="lessonsDropdown">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Schedule"
                                       asp-action="LessonsRooms">
                                        Аудитории
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Schedule"
                                       asp-action="LessonsTeachers">
                                        Преподаватели
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Schedule"
                                       asp-action="LessonsGroups">
                                        Группы
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <div class="small text-muted mt-2">
                            Выберите способ просмотра расписания.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card module-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">График дежурств</h5>
                    <p class="card-text">
                        Планирование дежурств в лаборатории: дежурные, даты и учебные пары.
                    </p>
                    <ul class="small mb-3">
                        <li>Назначение до двух дежурных на пару</li>
                        <li>Просмотр текущей и следующей недели</li>
                        <li>Редактирование графика</li>
                    </ul>
                    <div class="mt-auto">
                        <a asp-controller="DutySchedule" asp-action="Index"
                           class="btn btn-galaxy">
                            График дежурств
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card module-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Дежурные</h5>
                    <p class="card-text">
                        Справочник сотрудников, назначаемых на дежурства в лаборатории.
                    </p>
                    <ul class="small mb-3">
                        <li>Фамилия и имя дежурного</li>
                        <li>Должность</li>
                        <li>Контактные данные</li>
                    </ul>
                    <div class="mt-auto">
                        <a asp-controller="DutyPerson" asp-action="Index"
                           class="btn btn-outline-galaxy">
                            Список дежурных
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card module-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Аудитории</h5>
                    <p class="card-text">
                        Справочник аудиторий, используемых при фильтрации расписания.
                    </p>
                    <ul class="small mb-3">
                        <li>Номер аудитории</li>
                        <li>Вместимость</li>
                        <li>Признак использования в расписании</li>
                    </ul>
                    <div class="mt-auto">
                        <a asp-controller="Classroom" asp-action="Index"
                           class="btn btn-outline-galaxy">
                            Справочник аудиторий
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card module-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Преподаватели</h5>
                    <p class="card-text">
                        Справочник преподавателей, синхронизируемый из Core System.
                    </p>
                    <ul class="small mb-3">
                        <li>ФИО преподавателя</li>
                        <li>Идентификатор Core System</li>
                        <li>Использование в расписании</li>
                    </ul>
                    <div class="mt-auto">
                        <a asp-controller="Teacher" asp-action="Index"
                           class="btn btn-outline-galaxy">
                            Справочник преподавателей
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card module-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Группы</h5>
                    <p class="card-text">
                        Справочник учебных групп, синхронизируемый из Core System.
                    </p>
                    <ul class="small mb-3">
                        <li>Название группы</li>
                        <li>Идентификатор Core System</li>
                        <li>Использование в расписании</li>
                    </ul>
                    <div class="mt-auto">
                        <a asp-controller="Group" asp-action="Index"
                           class="btn btn-outline-galaxy">
                            Справочник групп
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>