@model LaboratoryHeadApp.Models.DutyScheduleCreateViewModel

@{
    ViewData["Title"] = "Создание графика дежурств";
    Layout = "_Layout";

    var dayNames = new[]
    {
        "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"
    };

    var fullDayNames = new[]
    {
        "Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье"
    };

    var monday = Model.Cells.Any()
        ? Model.Cells.Min(x => x.Date).Date
        : DateTime.Today;

    var currentWeek = Enumerable.Range(0, 7).Select(i => monday.AddDays(i)).ToList();
    var nextWeek = Enumerable.Range(0, 7).Select(i => monday.AddDays(7 + i)).ToList();
}

@functions {
    public int GetCellIndex(List<LaboratoryHeadApp.Models.DutyScheduleCellEditViewModel> cells, DateTime date, int lessonTimeId)
    {
        return cells.FindIndex(x => x.Date.Date == date.Date && x.LessonTimeId == lessonTimeId);
    }
}

<style>
    :root {
        --galaxy: #0B1F5C;
        --planetary: #334EAC;
        --sky: #D0E3FF;
        --line: rgba(11, 31, 92, .18);
        --soft: #f6f8ff;
    }

    .btn-galaxy {
        background: var(--galaxy);
        border-color: var(--galaxy);
        color: #fff;
        border-radius: 10px;
    }

        .btn-galaxy:hover {
            background: var(--planetary);
            border-color: var(--planetary);
            color: #fff;
        }

    .btn-outline-galaxy {
        color: var(--galaxy);
        border-color: var(--galaxy);
        border-radius: 10px;
        background: #fff;
    }

        .btn-outline-galaxy:hover {
            background: var(--galaxy);
            color: #fff;
        }

    .grid-card {
        border: 1px solid var(--line);
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

    .grid-title {
        font-weight: 800;
        color: var(--galaxy);
        margin: 0;
    }

    .scroll-wrap {
        overflow-x: auto;
        padding: 6px 8px 10px;
    }

    .duty-table {
        width: 100%;
        min-width: 1040px;
        border-collapse: separate;
        border-spacing: 4px;
        table-layout: fixed;
    }

        .duty-table th,
        .duty-table td {
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 5px;
            background: #fff;
            text-align: center;
            vertical-align: top;
        }

        .duty-table thead th {
            font-weight: 800;
            color: #0f172a;
            font-size: 0.82rem;
            line-height: 1.15;
        }

        .duty-table th:first-child,
        .duty-table td:first-child {
            width: 92px;
        }

    .pair-time {
        display: block;
        font-weight: 600;
        color: #64748b;
        font-size: 0.68rem;
        margin-top: 2px;
        white-space: nowrap;
    }

    .day-cell {
        text-align: center !important;
        font-weight: 800;
        color: var(--galaxy);
        background: linear-gradient(0deg, rgba(208,227,255,.45), rgba(208,227,255,.45)), #fff !important;
        white-space: nowrap;
        font-size: 0.82rem;
        line-height: 1.15;
    }

    .date-note {
        display: block;
        margin-top: 2px;
        font-size: 0.68rem;
        color: #64748b;
        font-weight: 600;
    }

    .cell-select {
        width: 100%;
        min-width: 0;
        font-size: 0.72rem;
        padding: 2px 22px 2px 5px;
        min-height: 28px;
        line-height: 1.1;
    }

        .cell-select + .cell-select {
            margin-top: 3px;
        }

    .topbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .top-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .week-header {
        padding: 10px 12px 0;
    }

        .week-header .grid-title {
            font-size: 16px;
        }

    .validation-summary-errors ul {
        margin-bottom: 0;
    }

    .compact-hint {
        color: #64748b;
        font-size: 0.85rem;
        margin-top: 4px;
    }
</style>

<div class="container-fluid py-4">
    <form asp-action="Create" method="post">
        <div class="topbar">
            <div>
                <h2 class="grid-title">Создание графика дежурств</h2>
                <div class="compact-hint">
                    В каждой ячейке можно выбрать до двух дежурных на пару.
                </div>
            </div>

            <div class="top-actions">
                <button type="submit" class="btn btn-galaxy">Сохранить</button>
                <a asp-action="Index" class="btn btn-outline-galaxy">Отмена</a>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

        <div class="grid-card mb-4">
            <div class="week-header">
                <h5 class="grid-title">Текущая неделя</h5>
            </div>

            <div class="scroll-wrap">
                <table class="duty-table">
                    <thead>
                        <tr>
                            <th>День</th>
                            @foreach (var lesson in Model.LessonTimes)
                            {
                                <th>
                                    @lesson.PairNumber пара
                                    <span class="pair-time">
                                        @lesson.StartTime.ToString(@"hh\:mm")–@lesson.EndTime.ToString(@"hh\:mm")
                                    </span>
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < currentWeek.Count; i++)
                        {
                            var date = currentWeek[i];

                            <tr>
                                <td class="day-cell" title="@fullDayNames[i]">
                                    @dayNames[i]
                                    <span class="date-note">@date.ToString("dd.MM")</span>
                                </td>

                                @foreach (var lesson in Model.LessonTimes)
                                {
                                    var index = GetCellIndex(Model.Cells, date, lesson.Id);

                                    <td>
                                        @if (index >= 0)
                                        {
                                            <input type="hidden" asp-for="Cells[index].Date" />
                                            <input type="hidden" asp-for="Cells[index].LessonTimeId" />
                                            <input type="hidden" asp-for="Cells[index].PairNumber" />
                                            <input type="hidden" asp-for="Cells[index].StartTime" />
                                            <input type="hidden" asp-for="Cells[index].EndTime" />

                                            <select asp-for="Cells[index].DutyPerson1Id"
                                        asp-items="Model.DutyPersonItems"
                                        class="form-select form-select-sm cell-select">
                                                <option value="">1-й</option>
                                            </select>

                                            <select asp-for="Cells[index].DutyPerson2Id"
                                        asp-items="Model.DutyPersonItems"
                                        class="form-select form-select-sm cell-select">
                                                <option value="">2-й</option>
                                            </select>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="grid-card">
            <div class="week-header">
                <h5 class="grid-title">Следующая неделя</h5>
            </div>

            <div class="scroll-wrap">
                <table class="duty-table">
                    <thead>
                        <tr>
                            <th>День</th>
                            @foreach (var lesson in Model.LessonTimes)
                            {
                                <th>
                                    @lesson.PairNumber пара
                                    <span class="pair-time">
                                        @lesson.StartTime.ToString(@"hh\:mm")–@lesson.EndTime.ToString(@"hh\:mm")
                                    </span>
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < nextWeek.Count; i++)
                        {
                            var date = nextWeek[i];

                            <tr>
                                <td class="day-cell" title="@fullDayNames[i]">
                                    @dayNames[i]
                                    <span class="date-note">@date.ToString("dd.MM")</span>
                                </td>

                                @foreach (var lesson in Model.LessonTimes)
                                {
                                    var index = GetCellIndex(Model.Cells, date, lesson.Id);

                                    <td>
                                        @if (index >= 0)
                                        {
                                            <input type="hidden" asp-for="Cells[index].Date" />
                                            <input type="hidden" asp-for="Cells[index].LessonTimeId" />
                                            <input type="hidden" asp-for="Cells[index].PairNumber" />
                                            <input type="hidden" asp-for="Cells[index].StartTime" />
                                            <input type="hidden" asp-for="Cells[index].EndTime" />

                                            <select asp-for="Cells[index].DutyPerson1Id"
                                        asp-items="Model.DutyPersonItems"
                                        class="form-select form-select-sm cell-select">
                                                <option value="">1-й</option>
                                            </select>

                                            <select asp-for="Cells[index].DutyPerson2Id"
                                        asp-items="Model.DutyPersonItems"
                                        class="form-select form-select-sm cell-select">
                                                <option value="">2-й</option>
                                            </select>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}