@using MolServiceContracts.ViewModels.Reports
@model FullInventoryReportViewModel

@{
    ViewData["Title"] = "Общий отчёт по оборудованию";
    Layout = "_Layout";

    var items = Model.Items?
        .Where(x => x.Quantity != 0)
        .ToList() ?? new List<InventoryReportItemViewModel>();
}

<style>
    :root {
        --galaxy: #0B1F5C;
        --planetary: #334EAC;
        --line: rgba(11, 31, 92, .18);
    }

    .btn-galaxy {
        background-color: var(--galaxy);
        border-color: var(--galaxy);
        color: #fff;
    }

        .btn-galaxy:hover,
        .btn-galaxy:focus {
            background-color: var(--planetary);
            border-color: var(--planetary);
            color: #fff;
        }

    .btn-outline-galaxy {
        color: var(--galaxy);
        border-color: var(--galaxy);
    }

        .btn-outline-galaxy:hover,
        .btn-outline-galaxy:focus {
            background-color: var(--galaxy);
            color: #fff;
        }

    .report-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .report-meta {
        color: #64748b;
        font-size: 14px;
    }

    .report-box {
        border: 1px solid var(--line);
        border-radius: 16px;
        background: #fff;
        padding: 18px;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

    .inventory-print-header {
        display: none;
        font-family: "Times New Roman", serif;
        color: #000;
        margin-bottom: 12px;
    }

    .inventory-title-row {
        display: grid;
        grid-template-columns: 1fr 150px;
        gap: 18px;
        align-items: start;
    }

    .inventory-title {
        text-align: center;
        font-weight: 700;
        font-size: 16px;
        line-height: 1.2;
        margin-top: 14px;
    }

    .inventory-subtitle {
        text-align: center;
        font-weight: 700;
        font-size: 12px;
        margin-top: 2px;
    }

    .inventory-date {
        text-align: center;
        font-size: 12px;
        margin-top: 8px;
    }

    .inventory-note {
        text-align: right;
        font-size: 10px;
        margin-bottom: 4px;
    }

    .codes-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 10px;
    }

        .codes-table td,
        .codes-table th {
            border: 1px solid #000;
            padding: 3px 4px;
            height: 18px;
        }

    .inventory-fields {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 26px;
        margin-top: 12px;
        font-size: 12px;
    }

    .field-row {
        display: grid;
        grid-template-columns: 185px 1fr;
        gap: 8px;
        align-items: end;
        min-height: 20px;
    }

    .field-line {
        border-bottom: 1px solid #000;
        height: 16px;
    }

    .section-title {
        font-family: "Times New Roman", serif;
        font-weight: 700;
        font-size: 13px;
        margin: 12px 0 6px;
    }

    .report-table th,
    .report-table td {
        vertical-align: middle;
    }

    .report-table th {
        text-align: center;
    }

    .column-number-row th {
        font-weight: 400;
        text-align: center;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        .container {
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .report-box {
            border: none;
            box-shadow: none;
            padding: 0;
        }

        .inventory-print-header {
            display: block;
        }

        .table-responsive {
            overflow: visible !important;
        }

        .report-table {
            font-family: "Times New Roman", serif;
            font-size: 11px;
        }

            .report-table th,
            .report-table td {
                border: 1px solid #000 !important;
                padding: 4px !important;
            }

        body {
            color: #000;
            background: #fff;
        }
    }
</style>

<div class="container py-4">
    <div class="report-header no-print">
        <div>
            <h2 class="mb-1">Общий отчёт по оборудованию кафедры ИС</h2>
            <div class="report-meta">
                Дата формирования: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="InventoryReport"
               asp-action="Index"
               class="btn btn-outline-galaxy">
                Назад к отчётам
            </a>

            <a asp-controller="InventoryReport"
               asp-action="DownloadFullInventoryPdf"
               class="btn btn-outline-galaxy">
                Скачать PDF
            </a>

            <button type="button" class="btn btn-galaxy" onclick="window.print()">
                Печать
            </button>
        </div>
    </div>

    <div class="report-box">
        <div class="inventory-print-header">
            <div class="inventory-title-row">
                <div>
                    <div class="inventory-title">
                        ИНВЕНТАРИЗАЦИОННАЯ ОПИСЬ (СЛИЧИТЕЛЬНАЯ ВЕДОМОСТЬ) № ____________
                    </div>
                    <div class="inventory-subtitle">
                        по объектам нефинансовых активов
                    </div>
                    <div class="inventory-date">
                        от «____» __________________ 20____ г.
                    </div>
                </div>

                <div>
                    <div class="inventory-note">
                        (в ред. Приказа Минфина России от 30.10.2023 № 174н)
                    </div>

                    <table class="codes-table">
                        <tr>
                            <th colspan="2">КОДЫ</th>
                        </tr>
                        <tr>
                            <td>Форма по ОКУД</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>Дата</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>по Сводному реестру</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>Глава по БК</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>по ОКТМО</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>по ОКЕИ</td>
                            <td></td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="inventory-fields">
                <div>
                    <div class="field-row">
                        <div>Учреждение</div>
                        <div class="field-line"></div>
                    </div>
                    <div class="field-row">
                        <div>Обособленное подразделение</div>
                        <div class="field-line"></div>
                    </div>
                    <div class="field-row">
                        <div>Структурное подразделение</div>
                        <div class="field-line"></div>
                    </div>
                    <div class="field-row">
                        <div>Тип имущества</div>
                        <div class="field-line"></div>
                    </div>
                    <div class="field-row">
                        <div>Наименование бюджета</div>
                        <div class="field-line"></div>
                    </div>
                    <div class="field-row">
                        <div>Единица измерения</div>
                        <div class="field-line"></div>
                    </div>
                </div>

                <div>
                    <div class="field-row">
                        <div>Ответственное лицо</div>
                        <div class="field-line"></div>
                    </div>
                    <div class="field-row">
                        <div>Решение о проведении инвентаризации</div>
                        <div class="field-line"></div>
                    </div>
                    <div class="field-row">
                        <div>Номер инвентаризационной комиссии</div>
                        <div class="field-line"></div>
                    </div>
                    <div class="field-row">
                        <div>Дата начала инвентаризации</div>
                        <div class="field-line"></div>
                    </div>
                    <div class="field-row">
                        <div>Дата окончания инвентаризации</div>
                        <div class="field-line"></div>
                    </div>
                    <div class="field-row">
                        <div>Дата, по состоянию на которую проводится инвентаризация</div>
                        <div class="field-line"></div>
                    </div>
                </div>
            </div>

            <div class="section-title">
                1. Сведения об объектах нефинансовых активов по данным бухгалтерского учета
            </div>
        </div>

        @if (!items.Any())
        {
            <div class="alert alert-warning mb-0">
                Оборудование не найдено.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle report-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;">Код строки</th>
                            <th>Наименование объекта нефинансового актива</th>
                            <th>Номер объекта учета</th>
                            <th>Место / подразделение проведения инвентаризации</th>
                            <th style="width: 90px;">Количество</th>
                        </tr>
                        <tr class="column-number-row">
                            <th>1</th>
                            <th>2</th>
                            <th>3</th>
                            <th>4</th>
                            <th>5</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < items.Count; i++)
                        {
                            var item = items[i];

                            <tr>
                                <td class="text-center">@(i + 1)</td>
                                <td>@item.FullName</td>
                                <td>@item.InventoryNumber</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Location) && !string.IsNullOrWhiteSpace(item.ClassroomNumber))
                                    {
                                        @($"{item.Location}, ауд. {item.ClassroomNumber}")
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.Location))
                                    {
                                        @item.Location
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.ClassroomNumber))
                                    {
                                        @($"ауд. {item.ClassroomNumber}")
                                    }
                                </td>
                                <td class="text-center">@FormatQuantity(item.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@functions {
    private static string FormatQuantity(decimal quantity)
    {
        return quantity % 1 == 0
            ? quantity.ToString("0")
            : quantity.ToString("0.##");
    }
}