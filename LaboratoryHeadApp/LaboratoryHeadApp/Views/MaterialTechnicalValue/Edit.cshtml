@model MolServiceContracts.BindingModels.MaterialTechnicalValueBindingModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using MolServiceDataModels.Enums

@{
    ViewData["Title"] = "Редактирование МТЦ";
    Layout = "_Layout";

    var isMaterialStock = Model.SourceType == MaterialTechnicalValueSourceType.MaterialStock;
    var codeLabel = isMaterialStock ? "Код номенклатуры" : "Инвентарный номер";
    var sectionName = isMaterialStock ? "Материальные запасы" : "Основные средства";

    var locationValue = string.IsNullOrWhiteSpace(Model.Location)
        ? "Кафедра ИС"
        : Model.Location;
}

<style>
    :root {
        --galaxy: #0B1F5C;
        --planetary: #334EAC;
        --line: rgba(11, 31, 92, .15);
        --soft: #f6f8ff;
    }

    .btn-galaxy {
        background-color: var(--galaxy);
        border-color: var(--galaxy);
        color: #fff;
    }

        .btn-galaxy:hover,
        .btn-galaxy:focus {
            background-color: var(--planetary);
            border-color: var(--planetary);
            color: #fff;
        }

    .btn-outline-galaxy {
        color: var(--galaxy);
        border-color: var(--galaxy);
    }

        .btn-outline-galaxy:hover,
        .btn-outline-galaxy:focus {
            background-color: var(--galaxy);
            color: #fff;
        }

    .source-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        background: var(--soft);
        color: var(--galaxy);
        border: 1px solid var(--line);
        font-size: .9rem;
        font-weight: 600;
    }

    .form-hint {
        color: #6c757d;
        font-size: .92rem;
        margin-top: 4px;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Редактирование МТЦ</h2>
            <span class="source-badge">@sectionName</span>
        </div>

        <a asp-action="Index"
           asp-route-sourceType="@Model.SourceType"
           class="btn btn-outline-galaxy">
            Назад
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />
                <input asp-for="SourceType" type="hidden" />
                <input asp-for="ExternalKey" type="hidden" />
                <input asp-for="Location" type="hidden" value="@locationValue" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="InventoryNumber" class="form-label">@codeLabel</label>
                    <input asp-for="InventoryNumber" class="form-control" />
                    <span asp-validation-for="InventoryNumber" class="text-danger"></span>

                    @if (isMaterialStock)
                    {
                        <div class="form-hint">
                            Для материальных запасов используется код номенклатуры из 1С.
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaterialResponsiblePersonId" class="form-label"></label>
                    <select asp-for="MaterialResponsiblePersonId"
                            asp-items="ViewBag.MaterialResponsiblePersons"
                            class="form-select">
                        <option value="">Выберите МОЛ</option>
                    </select>
                    <span asp-validation-for="MaterialResponsiblePersonId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ClassroomId" class="form-label"></label>
                    <select asp-for="ClassroomId"
                            asp-items="ViewBag.Classrooms"
                            class="form-select">
                        <option value="">Не закреплять за аудиторией</option>
                    </select>
                    <span asp-validation-for="ClassroomId" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-galaxy">
                        Сохранить
                    </button>

                    <a asp-action="Index"
                       asp-route-sourceType="@Model.SourceType"
                       class="btn btn-outline-secondary">
                        Отмена
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}