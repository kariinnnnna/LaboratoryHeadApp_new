@model List<MolServiceContracts.ViewModels.MaterialTechnicalValueViewModel>
@using MolServiceDataModels.Enums

@{
    ViewData["Title"] = "Материально-технические ценности";
    Layout = "_Layout";

    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 20;
    var totalCount = ViewBag.TotalCount as int? ?? 0;

    var sourceType = ViewBag.SourceType == null
        ? MaterialTechnicalValueSourceType.FixedAsset
        : (MaterialTechnicalValueSourceType)ViewBag.SourceType;

    var searchText = ViewBag.SearchText as string ?? string.Empty;

    var isFixedAsset = sourceType == MaterialTechnicalValueSourceType.FixedAsset;
    var isMaterialStock = sourceType == MaterialTechnicalValueSourceType.MaterialStock;

    var pageTitle = isFixedAsset
        ? "Основные средства"
        : "Материальные запасы";
}

<style>
    :root {
        --galaxy: #0B1F5C;
        --planetary: #334EAC;
        --danger-soft: #dc3545;
        --line: rgba(11, 31, 92, .15);
        --soft: #f6f8ff;
    }

    .btn-galaxy {
        background-color: var(--galaxy);
        border-color: var(--galaxy);
        color: #fff;
    }

        .btn-galaxy:hover,
        .btn-galaxy:focus {
            background-color: var(--planetary);
            border-color: var(--planetary);
            color: #fff;
        }

    .btn-outline-galaxy {
        color: var(--galaxy);
        border-color: var(--galaxy);
    }

        .btn-outline-galaxy:hover,
        .btn-outline-galaxy:focus {
            background-color: var(--galaxy);
            color: #fff;
        }

    .btn-outline-danger-soft {
        color: var(--danger-soft);
        border-color: var(--danger-soft);
    }

        .btn-outline-danger-soft:hover,
        .btn-outline-danger-soft:focus {
            background-color: var(--danger-soft);
            color: #fff;
        }

    .table thead {
        background-color: var(--galaxy);
        color: white;
    }

    .actions-cell {
        white-space: nowrap;
        width: 1%;
    }

    .pagination .page-link {
        color: var(--galaxy);
        border-color: var(--line);
    }

    .pagination .page-item.active .page-link {
        background-color: var(--galaxy);
        border-color: var(--galaxy);
        color: #fff;
    }

    .pagination .page-item.disabled .page-link {
        color: #6c757d;
    }

    .status-badge {
        display: inline-block;
        padding: 0.35rem 0.65rem;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 999px;
        white-space: nowrap;
    }

    .status-active {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    .status-writtenoff {
        background-color: #fdeaea;
        color: #b42318;
    }

    .row-writtenoff {
        background-color: #fff8f8;
    }

        .row-writtenoff td {
            color: #6c757d;
        }

    .modal-content {
        border-radius: 18px;
        border: 1px solid var(--line);
    }

    .modal-header {
        border-bottom: 1px solid var(--line);
    }

    .modal-footer {
        border-top: 1px solid var(--line);
    }

    .tabs-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 16px;
    }

    .tab-galaxy {
        border: 1px solid var(--line);
        background: #fff;
        color: var(--galaxy);
        border-radius: 999px;
        padding: 8px 16px;
        text-decoration: none;
        font-weight: 600;
        transition: .15s;
    }

        .tab-galaxy:hover {
            background: var(--soft);
            color: var(--galaxy);
        }

        .tab-galaxy.active {
            background: var(--galaxy);
            border-color: var(--galaxy);
            color: #fff;
        }

    .filter-panel {
        border: 1px solid var(--line);
        border-radius: 16px;
        background: #fff;
        padding: 14px;
        margin-bottom: 16px;
    }

    .summary-text {
        color: #6c757d;
        font-size: .95rem;
    }
</style>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Материально-технические ценности</h2>
            <div class="summary-text">
                Раздел: @pageTitle. Всего записей: @totalCount
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="MOL" asp-action="Index" class="btn btn-outline-galaxy">
                Назад
            </a>

            <button type="button"
                    class="btn btn-outline-galaxy"
                    data-bs-toggle="modal"
                    data-bs-target="#importInventoryModal">
                Синхронизировать с 1С
            </button>

            <a asp-controller="MaterialTechnicalValue"
               asp-action="Create"
               asp-route-sourceType="@sourceType"
               class="btn btn-galaxy">
                Добавить МТЦ
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="tabs-wrap">
        <a asp-action="Index"
           asp-route-sourceType="@MaterialTechnicalValueSourceType.FixedAsset"
           asp-route-page="1"
           asp-route-pageSize="@pageSize"
           asp-route-searchText="@searchText"
           class="tab-galaxy @(isFixedAsset ? "active" : "")">
            Основные средства
        </a>

        <a asp-action="Index"
           asp-route-sourceType="@MaterialTechnicalValueSourceType.MaterialStock"
           asp-route-page="1"
           asp-route-pageSize="@pageSize"
           asp-route-searchText="@searchText"
           class="tab-galaxy @(isMaterialStock ? "active" : "")">
            Материальные запасы
        </a>
    </div>

    <div class="filter-panel shadow-sm">
        <form method="get" asp-action="Index">
            <input type="hidden" name="sourceType" value="@sourceType" />
            <input type="hidden" name="page" value="1" />

            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label for="searchText" class="form-label">Поиск</label>
                    <input type="text"
                           id="searchText"
                           name="searchText"
                           value="@searchText"
                           class="form-control"
                           placeholder="Код, наименование, МОЛ, аудитория..." />
                </div>

                <div class="col-md-2">
                    <label for="pageSize" class="form-label">Показывать по</label>
                    <select id="pageSize" name="pageSize" class="form-select">
                        <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10</option>
                        <option value="20" selected="@(pageSize == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option>
                        <option value="100" selected="@(pageSize == 100 ? "selected" : null)">100</option>
                    </select>
                </div>

                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-galaxy">
                        Найти
                    </button>

                    <a asp-action="Index"
                       asp-route-sourceType="@sourceType"
                       asp-route-page="1"
                       asp-route-pageSize="@pageSize"
                       class="btn btn-outline-secondary">
                        Сбросить
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model == null || Model.Count == 0)
            {
                if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <div class="alert alert-light border mb-0">
                        По запросу «@searchText» ничего не найдено.
                    </div>
                }
                else
                {
                    <div class="alert alert-light border mb-0">
                        Список МТЦ пока пуст.
                    </div>
                }
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@(isMaterialStock ? "Код номенклатуры" : "Инвентарный номер")</th>
                                <th>Наименование</th>
                                <th>Количество</th>
                                <th>Аудитория</th>
                                <th>МОЛ</th>
                                <th class="actions-cell">Действия</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.Quantity == 0 ? "row-writtenoff" : "")">
                                    <td>@item.InventoryNumber</td>
                                    <td>@item.FullName</td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            <span>@item.Quantity</span>

                                            @if (item.Quantity == 0)
                                            {
                                                <span class="status-badge status-writtenoff">Списано</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-active">В эксплуатации</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.Quantity == 0)
                                        {
                                            <span class="text-muted">Списано</span>
                                        }
                                        else
                                        {
                                            @(string.IsNullOrWhiteSpace(item.ClassroomNumber)
                                                ? "Не закреплено"
                                                : item.ClassroomNumber)
                                        }
                                    </td>
                                    <td>@item.MaterialResponsiblePersonName</td>
                                    <td class="actions-cell">
                                        <div class="d-flex gap-2 align-items-center">
                                            <a asp-controller="MaterialTechnicalValue"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-galaxy">
                                                Детали
                                            </a>

                                            @if (string.IsNullOrWhiteSpace(item.ExternalKey))
                                            {
                                                <a asp-controller="MaterialTechnicalValue"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-galaxy">
                                                    Редактировать
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    Из 1С
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    var startPage = Math.Max(1, currentPage - 3);
                    var endPage = Math.Min(totalPages, currentPage + 3);

                    <nav class="mt-4">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                           asp-action="Index"
                           asp-route-sourceType="@sourceType"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-pageSize="@pageSize"
                           asp-route-searchText="@searchText">
                                    Назад
                                </a>
                            </li>

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                           asp-action="Index"
                           asp-route-sourceType="@sourceType"
                           asp-route-page="1"
                           asp-route-pageSize="@pageSize"
                           asp-route-searchText="@searchText">
                                        1
                                    </a>
                                </li>

                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link"
                           asp-action="Index"
                           asp-route-sourceType="@sourceType"
                           asp-route-page="@i"
                           asp-route-pageSize="@pageSize"
                           asp-route-searchText="@searchText">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (endPage < totalPages)
                            {
                                @if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }

                                <li class="page-item">
                                    <a class="page-link"
                           asp-action="Index"
                           asp-route-sourceType="@sourceType"
                           asp-route-page="@totalPages"
                           asp-route-pageSize="@pageSize"
                           asp-route-searchText="@searchText">
                                        @totalPages
                                    </a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link"
                           asp-action="Index"
                           asp-route-sourceType="@sourceType"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-pageSize="@pageSize"
                           asp-route-searchText="@searchText">
                                    Вперёд
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

<div class="modal fade" id="importInventoryModal" tabindex="-1" aria-labelledby="importInventoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importInventoryModalLabel">Синхронизация с 1С</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>

            <form asp-controller="OneCImport" asp-action="ImportInventory" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <div class="alert alert-light border">
                        Если используется временная ссылка к 1С без авторизации, логин и пароль можно не заполнять.
                    </div>

                    <div class="mb-3">
                        <label for="oneCUsername" class="form-label">Логин</label>
                        <input type="text"
                               id="oneCUsername"
                               name="Username"
                               class="form-control"
                               placeholder="Введите логин, если требуется" />
                    </div>

                    <div class="mb-3">
                        <label for="oneCPassword" class="form-label">Пароль</label>
                        <input type="password"
                               id="oneCPassword"
                               name="Password"
                               class="form-control"
                               placeholder="Введите пароль, если требуется" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Отмена
                    </button>

                    <button type="submit" class="btn btn-galaxy">
                        Запустить синхронизацию
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (TempData["OpenImportModal"] as string == "true")
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalElement = document.getElementById('importInventoryModal');

            if (modalElement) {
                var modal = new bootstrap.Modal(modalElement);
                modal.show();
            }
        });
    </script>
}