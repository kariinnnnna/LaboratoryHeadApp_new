@model LaboratoryHeadApp.Models.SoftwareAssignToClassroomViewModel

@{
    ViewData["Title"] = "Назначить ПО на аудиторию";
    Layout = "_Layout";
}

<h2 class="mb-4">Назначить ПО на всю аудиторию</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<form asp-action="AssignToClassroom" method="post" class="card shadow-sm p-4">
    <div class="mb-3">
        <label asp-for="ClassroomId" class="form-label"></label>
        <select asp-for="ClassroomId" asp-items="Model.Classrooms" class="form-select">
            <option value="">Выберите аудиторию</option>
        </select>
        <span asp-validation-for="ClassroomId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SoftwareId" class="form-label"></label>
        <select asp-for="SoftwareId" asp-items="Model.Softwares" class="form-select">
            <option value="">Выберите ПО</option>
        </select>
        <span asp-validation-for="SoftwareId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SetupDescription" class="form-label"></label>
        <textarea asp-for="SetupDescription" class="form-control" rows="3"></textarea>
        <span asp-validation-for="SetupDescription" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ClaimNumber" class="form-label"></label>
        <input asp-for="ClaimNumber" class="form-control" />
        <span asp-validation-for="ClaimNumber" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Назначить ПО</button>
        <a asp-controller="Software" asp-action="Index" class="btn btn-outline-secondary">Назад</a>
    </div>
</form>

@if (Model.Result != null)
{
    <div class="card mt-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Результат операции</h5>
            <p class="mb-1">Найдено оборудования: <strong>@Model.Result.FoundEquipmentCount</strong></p>
            <p class="mb-1">Создано записей: <strong>@Model.Result.CreatedCount</strong></p>
            <p class="mb-1">Пропущено дублей: <strong>@Model.Result.SkippedDuplicatesCount</strong></p>

            @if (Model.Result.Errors.Any())
            {
                <div class="mt-3">
                    <h6>Ошибки</h6>
                    <ul class="mb-0">
                        @foreach (var error in Model.Result.Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}