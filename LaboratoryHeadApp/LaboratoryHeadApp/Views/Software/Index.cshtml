@model List<MolServiceContracts.ViewModels.SoftwareViewModel>

@{
    ViewData["Title"] = "Список ПО";
    Layout = "_Layout";

    var searchText = Convert.ToString(ViewBag.SearchText) ?? string.Empty;
    var currentPage = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var totalPages = (int)(ViewBag.TotalPages ?? 0);

    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);
}

<style>
    :root {
        --galaxy: #0B1F5C;
        --planetary: #334EAC;
        --sky: #D0E3FF;
        --danger-soft: #dc3545;
    }

    .btn-galaxy {
        background-color: var(--galaxy);
        border-color: var(--galaxy);
        color: #fff;
    }

        .btn-galaxy:hover,
        .btn-galaxy:focus {
            background-color: var(--planetary);
            border-color: var(--planetary);
            color: #fff;
        }

    .btn-outline-galaxy {
        color: var(--galaxy);
        border-color: var(--galaxy);
    }

        .btn-outline-galaxy:hover,
        .btn-outline-galaxy:focus {
            background-color: var(--galaxy);
            color: #fff;
        }

    .btn-outline-danger-soft {
        color: var(--danger-soft);
        border-color: var(--danger-soft);
    }

        .btn-outline-danger-soft:hover,
        .btn-outline-danger-soft:focus {
            background-color: var(--danger-soft);
            color: #fff;
        }

    .table thead {
        background-color: var(--galaxy);
        color: white;
    }

    .actions-cell {
        white-space: nowrap;
        width: 1%;
    }

    .search-card {
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
    }

    .text-muted-small {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .page-item.active .page-link {
        background-color: var(--galaxy);
        border-color: var(--galaxy);
    }

    .page-link {
        color: var(--galaxy);
    }
</style>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Справочник ПО</h2>
            <div class="text-muted-small">
                Всего записей: @totalCount
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="MOL" asp-action="Index" class="btn btn-outline-galaxy">
                Назад
            </a>

            <a asp-controller="Software" asp-action="Create" class="btn btn-galaxy">
                Добавить ПО
            </a>

            <a asp-controller="SoftwareRecord" asp-action="AssignToClassroom" class="btn btn-galaxy">
                Назначить ПО на аудиторию
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <form method="get" class="card search-card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-7">
                    <label class="form-label">Поиск</label>
                    <input type="text"
                           name="searchText"
                           value="@searchText"
                           class="form-control"
                           placeholder="Наименование, описание, ключ..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Показывать по</label>
                    <select name="pageSize" class="form-select">
                        <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10</option>
                        <option value="20" selected="@(pageSize == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option>
                        <option value="100" selected="@(pageSize == 100 ? "selected" : null)">100</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-galaxy">
                        Найти
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Сбросить
                    </a>
                </div>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model == null || Model.Count == 0)
            {
                if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <div class="alert alert-light border mb-0">
                        По запросу «@searchText» ничего не найдено.
                    </div>
                }
                else
                {
                    <div class="alert alert-light border mb-0">
                        Список ПО пока пуст.
                    </div>
                }
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="text-muted-small">
                        Страница @currentPage из @totalPages
                    </div>

                    <div class="text-muted-small">
                        Показано: @Model.Count
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Наименование ПО</th>
                                <th>Описание</th>
                                <th>Ключ</th>
                                <th>Дополнительный ключ</th>
                                <th class="actions-cell">Действия</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.SoftwareName</td>
                                    <td>@item.SoftwareDescription</td>
                                    <td>@item.SoftwareKey</td>
                                    <td>@item.SoftwareK</td>

                                    <td class="actions-cell">
                                        <div class="d-flex gap-2">
                                            <a asp-controller="Software"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-galaxy">
                                                Редактировать
                                            </a>

                                            <form asp-controller="Software"
                                          asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          onsubmit="return confirm('Удалить ПО?');">
                                                <button type="submit"
                                                class="btn btn-sm btn-outline-danger-soft">
                                                    Удалить
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <nav class="mt-3">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-pageSize="@pageSize"
                           asp-route-searchText="@searchText">
                                    Назад
                                </a>
                            </li>

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-pageSize="@pageSize"
                           asp-route-searchText="@searchText">
                                        1
                                    </a>
                                </li>

                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            @for (var i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(currentPage == i ? "active" : "")">
                                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-pageSize="@pageSize"
                           asp-route-searchText="@searchText">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (endPage < totalPages)
                            {
                                @if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }

                                <li class="page-item">
                                    <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@totalPages"
                           asp-route-pageSize="@pageSize"
                           asp-route-searchText="@searchText">
                                        @totalPages
                                    </a>
                                </li>
                            }

                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-pageSize="@pageSize"
                           asp-route-searchText="@searchText">
                                    Вперёд
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>